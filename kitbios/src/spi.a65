.PC02

.MACPACK    generic

.INCLUDE    "kit1.inc"

.EXPORT     spi_xfer


;===============================================================================
; SPI FUNCTIONS
;===============================================================================

;= SPI XFER ====================================================================
; Read and write a byte via SPI.
;
; Parameters:
;   A - output byte.
;
; Returns:
;   A - input byte.
;
; Remarks:
;   This function bit-bangs the SPI protocol to send and receive a single byte.
;   SPI clock rate is ~119 kHz with a 5 MHz CPU clock.

.PROC spi_xfer

            sta     byOut
            stz     byIn
            
            lda     VIA_IRA             ; we don't want to change nCS
            and     #SDC_nCS            ; isolate nCS
            ora     #SDC_CLK            ; make sure CLK high
            sta     byVIAShadow         ; save in shadow register
            
            lda     #0                  ; starting value for output register
            ldx     #8                  ; 8-bits
            
            sei                         ; no interrupts!
            
            ;- bit sending routine is 42 cycles total --------------------------
loop:       asl     byOut               ; (5) shift transmit bit to C flag
            ror     A                   ; (2) rotate transmit bit into A
            lsr     A                   ; (2) shift transmit bit to MOSI bit
            ora     byVIAShadow         ; (3) combine MOSI with shadow register
            sta     VIA_ORA             ; (4) send it to the SPI port
            
            lda     VIA_IRA             ; (4) get MISO bit
            asl     A                   ; (2) shift MISO bit to C flag
            rol     byIn                ; (5) rotate MISO bit into received byte
            
            lda     #0                  ; (2) start fresh and timing adjustment
            nop                         ; (2) timing adjustment
                        
            dec     VIA_ORA             ; (6) toggle CLK low
            
            dex                         ; (2) decrement bit counter
            bnz     loop                ; (3) check for zero rollover
            
            ;- clean up and return ---------------------------------------------
            cli                         ; OK, turn interrupts back on
            
            lda     byIn                ; return the received byte in A
            rts

.ENDPROC


;===============================================================================

.END
