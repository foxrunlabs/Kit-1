            .WORD invalid               ; N
            .WORD invalid               ; O
            .WORD invalid               ; P
            .WORD invalid               ; Q
            .WORD regs                  ; R
            .WORD stack                 ; S
            .WORD invalid               ; T
            .WORD invalid               ; U
            .WORD invalid               ; V
            .WORD sdcard                ; W
            .WORD invalid               ; X
            .WORD invalid               ; Y
            .WORD invalid               ; Z

            
;= VT100 COMMANDS ==============================================================

.RODATA

clrln:      .BYTE ESC, "[2K", CR, NUL   ; clear entire line and reset cursor


;= STRINGS =====================================================================

.RODATA

help_msg:   .BYTE "dump",  HT, HT,  "D [address]", LF
            .BYTE "enter", HT, HT,  "E address list", LF
            .BYTE "fill",  HT, HT,  "F range byte", LF
            .BYTE "help",  HT, HT,  "?", LF
            .BYTE "jump",  HT, HT,  "J [address]", LF
            .BYTE "load",  HT, HT,  "L sector address", LF
        .IFDEF PY65
            .BYTE "py65mon", HT, HT, "^D", LF
        .ENDIF
            .BYTE "register",  HT,  "R [register byte]", LF
            .BYTE "reset", HT, HT,  "^R", LF
            .BYTE "stack", HT, HT,  "S", LF
            .BYTE "write", HT, HT,  "W sector address", LF
            .BYTE NUL

reg_hdr:    .BYTE " PC  A  X  Y  S  NV-BDIZC", LF, NUL


;===============================================================================
; UNINITIALIZED DATA
;===============================================================================

.BSS

cmdln:      .RES CMDMAX+1               ; command line buffer, add room for NUL

byte:
word:
dword:      .RES 4                      ; used in getbyte/getword/getdword


;===============================================================================

.END
