.PC02

.MACPACK    generic

.INCLUDE    "kit1.inc"

.IMPORT     read

.EXPORT     fat16_init
.EXPORT     fat16_find
.EXPORT     fat16_read


;===============================================================================
; FAT16 FUNCTIONS
;===============================================================================

;= FAT16 INIT ==================================================================
; Initialize FAT16 volume.
;
; Parameters:
;   none.
;
; Returns:
;   A = status.
;
; Remarks:
;   This function loads the master boot record from a SD card, verifies the
;   first partition is FAT16, loads the boot sector, and then computes the FAT,
;   root directory, and data regions. It returns zero if unsuccessful and
;   returns one if successful.

.CODE

.PROC fat16_init

            ;- load master boot record -----------------------------------------
            stz     SECTOR              ; master boot record lives at sector 0
            stz     SECTOR+1
            stz     SECTOR+2
            stz     SECTOR+3
            lda     #.LOBYTE(MBR)       ; destination address for sector data
            ldx     #.HIBYTE(MBR)
        .IFNDEF SIM                     ; don't read SD card in simulator
            jsr     read                ; read master boot record from SD card
            bze     error               ; branch if error
        .ENDIF
            
            ;- check for boot signature $AA55 ----------------------------------
            lda     MBRSIG              ; read MBR boot signature
            cmp     #.LOBYTE(SIGNATURE) ; check for correct boot signature
            bne     error               ; branch if invalid
            lda     MBRSIG+1            ; read MBR boot signature
            cmp     #.HIBYTE(SIGNATURE) ; check for correct boot signature
            bne     error               ; branch if invalid
            
            ;- verify first partition is FAT16 ---------------------------------
            lda     P1TYPE              ; read partition #1 type
            cmp     #FAT16ID            ; compare with FAT16 type code
            bne     error               ; branch if not FAT16
            
            ;- load FAT16 boot sector ------------------------------------------
            lda     P1SECTOR            ; read 32-bit FAT16 boot sector LBA
            sta     SECTOR              ; copy to SECTOR parameter
            lda     P1SECTOR+1
            sta     SECTOR+1
            lda     P1SECTOR+2
            sta     SECTOR+2
            lda     P1SECTOR+3
            sta     SECTOR+3
            lda     #.LOBYTE(BOOT)      ; destination address for sector data
            ldx     #.HIBYTE(BOOT)
        .IFNDEF SIM                     ; don't read SD card in simulator
            jsr     read                ; read FAT16 boot sector from SD card
            bze     error               ; branch if success
        .ENDIF
            
            ;- check for boot signature $AA55 ----------------------------------
            lda     BOOTSIG             ; read boot sector boot signature
            cmp     #.LOBYTE(SIGNATURE) ; check for correct boot signature
            bne     error               ; branch if invalid
            lda     BOOTSIG+1           ; read boot sector boot signature
            cmp     #.HIBYTE(SIGNATURE) ; check for correct boot signature
            bne     error               ; branch if invalid
            
            ;- verify 512 bytes per logical sector -----------------------------
            lda     BPERSEC             ; read bytes per sector
            cmp     #.LOBYTE(512)       ; verify 512 bytes per sector
            bne     error               ; branch if invalid
            lda     BPERSEC+1
            cmp     #.HIBYTE(512)
            beq     fatregion
            
            ;- error -----------------------------------------------------------
error:      lda     #0                  ; not initialized
            bra     exit                ; all done
            
            ;- compute FAT region starting sector ------------------------------
fatregion:  lda     SECTOR              ; read 32-bit FAT16 boot sector LBA
            add     RESSEC              ; add number of reserved sectors
            sta     FATREG              ; store 32-bit FAT region sector LBA
            lda     SECTOR+1
            adc     RESSEC+1
            sta     FATREG+1
            lda     SECTOR+2
            adc     #0                  ; extend 16-bit value to 32-bit2
            sta     FATREG+2
            lda     SECTOR+3
            adc     #0
            sta     FATREG+3
            
            ;- compute root directory region starting sector -------------------
            lda     FATREG              ; read 32-bit FAT region sector LBA
            sta     ROOTREG             ; copy to root dir. region sector LBA
            lda     FATREG+1
            sta     ROOTREG+1
            lda     FATREG+2
            sta     ROOTREG+2
            lda     FATREG+3
            sta     ROOTREG+3
            
            ldx     NUMFAT              ; load FAT number counter
rootregion: lda     ROOTREG             ; read 16-bit FAT region sector LBA
            add     SECPERFAT           ; add number of sectors per FAT
            sta     ROOTREG             ; store root directory region sector LBA
            lda     ROOTREG+1
            adc     SECPERFAT+1
            sta     ROOTREG+1
            lda     ROOTREG+2
            adc     #0                  ; extend 16-bit value to 32-bits
            sta     ROOTREG+2
            lda     ROOTREG+3
            adc     #0
            sta     ROOTREG+3
            
            dex                         ; decrement FAT number counter
            bnz     rootregion          ; branch if more remain
            
            ;- compute data region starting sector -----------------------------
            lda     ROOTREG             ; read root directory region sector LBA
            add     #.LOBYTE(32)        ; add root directory region size
            sta     DATAREG             ; store data region sector LBA
            lda     ROOTREG+1
            adc     #.HIBYTE(32)
            sta     DATAREG+1
            lda     ROOTREG+2
            adc     #0                  ; extend 16-bit value to 32-bits
            sta     DATAREG+2
            lda     ROOTREG+3
            adc     #0
            sta     DATAREG+3
            
            ;- complete --------------------------------------------------------
            lda     #1                  ; initialized
exit:       rts                         ; done!

.ENDPROC


;= FAT16 FIND ==================================================================
; Find a file on disk.
;
; Parameters:
;   X:A = 16-bit address of 8+3 character file name string.
;
; Returns:
;   X:A = 16-bit starting cluster.
;
; Remarks:
;   This function finds a file in the root directory. It returns the starting
;   cluster of the file or zero on error.

.CODE

.PROC fat16_find

            sta     FILENAME            ; save address of file name string
            stx     FILENAME+1
            
            ;- load root directory region --------------------------------------
            lda     ROOTREG             ; read root directory region LBA
            sta     SECTOR              ; copy to SECTOR argument
            lda     ROOTREG+1
            sta     SECTOR+1
            lda     ROOTREG+2
            sta     SECTOR+2
            lda     ROOTREG+3
            sta     SECTOR+3
            lda     #.LOBYTE(ROOT)      ; destination address for sector data
            ldx     #.HIBYTE(ROOT)
        .IFNDEF SIM                     ; don't read SD card in simulator
            jsr     read                ; read root directory region from SDC
            bze     error               ; branch if error
        .ENDIF
            
            ;- search for file in root directory -------------------------------
newtable:   lda     #.LOBYTE(ROOT)      ; load root directory region address
            sta     DIRENTRY            ; store as first directory entry
            lda     #.HIBYTE(ROOT)
            sta     DIRENTRY+1
            ldx     #16                 ; 16 entries per sector
            
newentry:   ldy     #0                  ; reset character counter
findfile:   lda     (DIRENTRY), Y       ; read character from filename
            bze     error               ; branch if NUL
            cmp     (FILENAME), Y       ; compare with file name
            bne     nextfile            ; branch if not equal
            
            iny                         ; increment character counter
            cpy     #11                 ; maximum of 8+3 filename characters
            beq     startclust          ; branch if all 8+3 characters match
            bra     findfile            ; keep comparing characters
            
nextfile:   lda     DIRENTRY            ; load directory entry address
            add     #.LOBYTE(32)        ; directory entries are 32 bytes
            sta     DIRENTRY            ; store directory entry address
            lda     DIRENTRY+1
            adc     #.HIBYTE(32)
            sta     DIRENTRY+1
            
            dex                         ; decrement directory entry counter
            bnz     newentry            ; branch if more entries exist
            
            lda     SECTOR              ; load current root directory region LBA
            add     #1                  ; increment by one
            sta     SECTOR              ; store root directory region LBA
            lda     SECTOR+1
            adc     #0
            sta     SECTOR+1
            lda     SECTOR+2
            adc     #0
            sta     SECTOR+2
            lda     SECTOR+3
            adc     #0
            sta     SECTOR+3            
            lda     #.LOBYTE(ROOT)      ; destination for sector data
            ldx     #.HIBYTE(ROOT)
        .IFNDEF SIM                     ; don't read SD card in simulator
            jsr     read                ; read root directory region from SDC
            bze     error               ; branch if error
        .ENDIF
            
            bra     newtable            ; start the process over again
            
            ;- extract starting cluster ----------------------------------------
startclust: ldy     #CLUSTEROFF         ; load cluster offset
            iny                         ; read MSB first
            lda     (DIRENTRY), Y       ; read starting cluster number
            tax                         ; move MSB to X
            dey                         ; decrement offset to get LSB
            lda     (DIRENTRY), Y       ; read first cluster number
            bra     exit                ; all done
            
            ;- error returns zero ----------------------------------------------
error:      lda     #0
            ldx     #0
            
            ;- exit ------------------------------------------------------------
exit:       rts                         ; done!

.ENDPROC


;= FAT16 READ ==================================================================
; Read a file from disk.
;
; Parameters:
;   X:A     = 16-bit destination address.
;   CLUSTER = starting cluster of file.
;
; Returns:
;   A = status.
;
; Remarks:
;   This function reads a file into RAM. It returns zero if unsuccessful or one
;   if successful.

.CODE

.PROC fat16_read

            sta     dest                ; save destination address
            stx     dest+1
            
            ;- compute sector for cluster --------------------------------------
loadfat:    lda     CLUSTER+1           ; load 16-bit cluster MSB
            sta     SECTOR              ; store in SECTOR argument
            lsr     SECTOR              ; divide-by-2 (effective divide-by-512)
            
            ;- load appropriate portion of FAT for cluster ---------------------
            lda     FATREG              ; load FAT region sector LBA
            add     SECTOR              ; add computed sector for cluster
            sta     SECTOR              ; store in SECTOR argument
            lda     FATREG+1
            adc     #0                  ; extend 8-bit value to 32-bits
            sta     SECTOR+1
            lda     FATREG+2
            adc     #0
            sta     SECTOR+2
            lda     FATREG+3
            adc     #0
            sta     SECTOR+3
            lda     #.LOBYTE(FAT)       ; destination address for sector data
            ldx     #.HIBYTE(FAT)
        .IFNDEF SIM                     ; don't read SD card in simulator
            jsr     read                ; read root directory region from SDC
            bze     error               ; branch if error
        .ENDIF
            
            ;- compute offset into data region ---------------------------------
            lda     CLUSTER             ; load cluster number
            sub     #.LOBYTE(2)         ; sub. 2 to compute data region offset
            sta     SECTOR              ; store data region offset
            lda     CLUSTER+1
            sbc     #.HIBYTE(2)
            sta     SECTOR+1
            
            ;- compute RAM address of cluster ----------------------------------
            lda     CLUSTER             ; load cluster number
            and     #.LOBYTE(255)       ; adjust to 0-255 range
            asl     A                   ; multiply by 2 since 16-bit cluster no.
            sta     CLUSTER             ; store address offset
            lda     CLUSTER+1
            and     #.HIBYTE(255)
            rol     A
            sta     CLUSTER+1
            
            lda     CLUSTER             ; load FAT address offset
            add     #.LOBYTE(FAT)       ; add FAT address
            sta     CLUSTER             ; store cluster address
            lda     CLUSTER+1
            adc     #.HIBYTE(FAT)
            sta     CLUSTER+1
            
            ;- check for bad sector --------------------------------------------
            ldy     #1                  ; offset from cluster address
            lda     (CLUSTER), Y        ; load MSB of 16-bit cluster
            cmp     #.HIBYTE(BADSECTOR) ; compare with bad sector marker
            bne     ldcluster           ; branch if good sector
            lda     (CLUSTER)           ; load LSB of 16-bit cluster
            cmp     #.LOBYTE(BADSECTOR) ; compare with bad sector marker
            bne     ldcluster           ; branch if good sector
            
            ;- error -----------------------------------------------------------
error:      lda     #0                  ; file not loaded
            bra     exit
            
            ;- load cluster from SD card ---------------------------------------
ldcluster:  lda     DATAREG             ; load data region sector LBA
            add     SECTOR              ; add offset for cluster sector
            sta     SECTOR              ; store offset sector LBA
            lda     DATAREG+1
            adc     SECTOR+1
            sta     SECTOR+1
            lda     DATAREG+2
            adc     #0                  ; expand 16-bit value to 32-bits
            sta     SECTOR+2
            lda     DATAREG+3
            adc     #0
            sta     SECTOR+3
            lda     dest                ; destination address for sector data
            ldx     dest+1
        .IFNDEF SIM                     ; don't read SD card in simulator
            jsr     read                ; read data region from SDC
            bze     error               ; branch if error
        .ENDIF
            
            ;- check for end of cluster chain ----------------------------------
            ldy     #1                  ; offset for 16-bit cluster
            lda     (CLUSTER), Y        ; load cluster MSB
            cmp     #.HIBYTE($FFF0)     ; valid clusters are $0002-$FFEF 
            blt     lowerbound          ; branch if MSB less than $FF
            lda     (CLUSTER)           ; load cluster LSB
            cmp     #.LOBYTE($FFF0)     ; valid clusters are $0002-$FFEF
            bge     complete            ; branch if LSB >= $F0
            
lowerbound: lda     (CLUSTER), Y        ; load cluster MSB
            cmp     #.HIBYTE($0002)     ; valid clusters are $0002-$FFEF
            bnz     nextclust           ; branch if MSB not $00
            lda     (CLUSTER)           ; load cluster LSB
            cmp     #.LOBYTE($0002)     ; valid clusters are $0002-$FFEF
            blt     complete            ; branch if LSB less than $02
            
            ;- get next cluster number -----------------------------------------
nextclust:  lda     (CLUSTER)           ; load next cluster LSB
            tax                         ; store in X temporarily
            lda     (CLUSTER), Y        ; load next cluster MSB
            sta     CLUSTER+1           ; store new cluster MSB
            txa                         ; load new cluster LSB
            sta     CLUSTER             ; store new cluster LSB
            
            ;- increment destination address by 512 bytes ----------------------
            lda     dest                ; load destination address
            add     #.LOBYTE(512)       ; increment by 512
            sta     dest                ; store new destination address
            lda     dest+1
            adc     #.HIBYTE(512)
            sta     dest+1
            
            jmp     loadfat             ; keep loading the FAT
            
            ;- complete --------------------------------------------------------
complete:   lda     #1                  ; file load complete
exit:       rts                         ; done!

.ENDPROC


;===============================================================================
; UNINITIALIZED DATA
;===============================================================================

.BSS

dest:       .RES 2


;===============================================================================

.END
