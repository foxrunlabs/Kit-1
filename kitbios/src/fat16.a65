.PC02

.MACPACK    generic

.INCLUDE    "kit1.inc"

.IMPORT     read

.EXPORT     fat16_init
.EXPORT     fat16_find
.EXPORT     fat16_read


;===============================================================================
; FAT16 FUNCTIONS
;===============================================================================

;= FAT16 INIT ==================================================================
; Initialize FAT16 volume.
;
; Parameters:
;   none.
;
; Returns:
;   A = status.
;
; Remarks:
;   This function loads the master boot record from a SD card, verifies the
;   first partition is FAT16, loads the boot sector, and then computes the FAT,
;   root directory, and data regions. It returns zero if unsuccessful and
;   returns one if successful.

.CODE

.PROC fat16_init

            ;- load master boot record -----------------------------------------
            stz     dwSector            ; master boot record lives at sector 0
            stz     dwSector+1
            stz     dwSector+2
            stz     dwSector+3
            lda     #.LOBYTE(MBR)       ; destination address for sector data
            ldx     #.HIBYTE(MBR)
        .IFNDEF SIM                     ; don't read SD card in simulator
            jsr     read                ; read master boot record from SD card
            bze     error               ; branch if error
        .ENDIF
            
            ;- check for boot signature $AA55 ----------------------------------
            lda     wMBRSig             ; read MBR boot signature
            cmp     #.LOBYTE(SIGNATURE) ; check for correct boot signature
            bne     error               ; branch if invalid
            lda     wMBRSig+1           ; read MBR boot signature
            cmp     #.HIBYTE(SIGNATURE) ; check for correct boot signature
            bne     error               ; branch if invalid
            
            ;- verify first partition is FAT16 ---------------------------------
            lda     byP1Type            ; read partition #1 type
            cmp     #FAT16ID            ; compare with FAT16 type code
            bne     error               ; branch if not FAT16
            
            ;- load FAT16 boot sector ------------------------------------------
            lda     dwP1Sector          ; read 32-bit FAT16 boot sector LBA
            sta     dwSector            ; copy to dwSector parameter
            lda     dwP1Sector+1
            sta     dwSector+1
            lda     dwP1Sector+2
            sta     dwSector+2
            lda     dwP1Sector+3
            sta     dwSector+3
            lda     #.LOBYTE(BOOT)      ; destination address for sector data
            ldx     #.HIBYTE(BOOT)
        .IFNDEF SIM                     ; don't read SD card in simulator
            jsr     read                ; read FAT16 boot sector from SD card
            bze     error               ; branch if success
        .ENDIF
            
            ;- check for boot signature $AA55 ----------------------------------
            lda     wBootSig            ; read boot sector boot signature
            cmp     #.LOBYTE(SIGNATURE) ; check for correct boot signature
            bne     error               ; branch if invalid
            lda     wBootSig+1          ; read boot sector boot signature
            cmp     #.HIBYTE(SIGNATURE) ; check for correct boot signature
            bne     error               ; branch if invalid
            
            ;- verify 512 bytes per logical sector -----------------------------
            lda     wBPerSec            ; read bytes per sector
            cmp     #.LOBYTE(512)       ; verify 512 bytes per sector
            bne     error               ; branch if invalid
            lda     wBPerSec+1
            cmp     #.HIBYTE(512)
            beq     fatregion
            
            ;- error -----------------------------------------------------------
error:      lda     #0                  ; not initialized
            bra     exit                ; all done
            
            ;- compute FAT region starting sector ------------------------------
fatregion:  lda     dwSector            ; read 32-bit FAT16 boot sector LBA
            add     wRsrvSec            ; add number of reserved sectors
            sta     dwFATRegion         ; store 32-bit FAT region sector LBA
            lda     dwSector+1
            adc     wRsrvSec+1
            sta     dwFATRegion+1
            lda     dwSector+2
            adc     #0                  ; extend 16-bit value to 32-bit2
            sta     dwFATRegion+2
            lda     dwSector+3
            adc     #0
            sta     dwFATRegion+3
            
            ;- compute root directory region starting sector -------------------
            lda     dwFATRegion         ; read 32-bit FAT region sector LBA
            sta     dwRootRegion        ; copy to root dir. region sector LBA
            lda     dwFATRegion+1
            sta     dwRootRegion+1
            lda     dwFATRegion+2
            sta     dwRootRegion+2
            lda     dwFATRegion+3
            sta     dwRootRegion+3
            
            ldx     byNumFAT            ; load FAT number counter
rootregion: lda     dwRootRegion        ; read 16-bit FAT region sector LBA
            add     wSecPerFAT          ; add number of sectors per FAT
            sta     dwRootRegion        ; store root directory region sector LBA
            lda     dwRootRegion+1
            adc     wSecPerFAT+1
            sta     dwRootRegion+1
            lda     dwRootRegion+2
            adc     #0                  ; extend 16-bit value to 32-bits
            sta     dwRootRegion+2
            lda     dwRootRegion+3
            adc     #0
            sta     dwRootRegion+3
            
            dex                         ; decrement FAT number counter
            bnz     rootregion          ; branch if more remain
            
            ;- compute data region starting sector -----------------------------
            lda     dwRootRegion        ; read root directory region sector LBA
            add     #.LOBYTE(32)        ; add root directory region size
            sta     dwDataRegion        ; store data region sector LBA
            lda     dwRootRegion+1
            adc     #.HIBYTE(32)
            sta     dwDataRegion+1
            lda     dwRootRegion+2
            adc     #0                  ; extend 16-bit value to 32-bits
            sta     dwDataRegion+2
            lda     dwRootRegion+3
            adc     #0
            sta     dwDataRegion+3
            
            ;- complete --------------------------------------------------------
            lda     #1                  ; initialized
exit:       rts                         ; done!

.ENDPROC


;= FAT16 FIND ==================================================================
; Find a file on disk.
;
; Parameters:
;   X:A = 16-bit address of 8+3 character file name string.
;
; Returns:
;   X:A = 16-bit starting cluster.
;
; Remarks:
;   This function finds a file in the root directory. It returns the starting
;   cluster of the file or zero on error.

.CODE

.PROC fat16_find

            sta     psFilename          ; save address of file name string
            stx     psFilename+1
            
            ;- load root directory region --------------------------------------
            lda     dwRootRegion        ; read root directory region LBA
            sta     dwSector            ; copy to dwSector argument
            lda     dwRootRegion+1
            sta     dwSector+1
            lda     dwRootRegion+2
            sta     dwSector+2
            lda     dwRootRegion+3
            sta     dwSector+3
            lda     #.LOBYTE(ROOT)      ; destination address for sector data
            ldx     #.HIBYTE(ROOT)
        .IFNDEF SIM                     ; don't read SD card in simulator
            jsr     read                ; read root directory region from SDC
            bze     error               ; branch if error
        .ENDIF
            
            ;- search for file in root directory -------------------------------
newtable:   lda     #.LOBYTE(ROOT)      ; load root directory region address
            sta     pdirEntry           ; store as first directory entry
            lda     #.HIBYTE(ROOT)
            sta     pdirEntry+1
            ldx     #16                 ; 16 entries per sector
            
newentry:   ldy     #0                  ; reset character counter
findfile:   lda     (pdirEntry), Y      ; read character from filename
            bze     error               ; branch if NUL
            cmp     (psFilename), Y     ; compare with file name
            bne     nextfile            ; branch if not equal
            
            iny                         ; increment character counter
            cpy     #11                 ; maximum of 8+3 filename characters
            beq     startclust          ; branch if all 8+3 characters match
            bra     findfile            ; keep comparing characters
            
nextfile:   lda     pdirEntry           ; load directory entry address
            add     #.LOBYTE(32)        ; directory entries are 32 bytes
            sta     pdirEntry           ; store directory entry address
            lda     pdirEntry+1
            adc     #.HIBYTE(32)
            sta     pdirEntry+1
            
            dex                         ; decrement directory entry counter
            bnz     newentry            ; branch if more entries exist
            
            lda     dwSector            ; load current root directory region LBA
            add     #1                  ; increment by one
            sta     dwSector            ; store root directory region LBA
            lda     dwSector+1
            adc     #0
            sta     dwSector+1
            lda     dwSector+2
            adc     #0
            sta     dwSector+2
            lda     dwSector+3
            adc     #0
            sta     dwSector+3            
            lda     #.LOBYTE(ROOT)      ; destination for sector data
            ldx     #.HIBYTE(ROOT)
        .IFNDEF SIM                     ; don't read SD card in simulator
            jsr     read                ; read root directory region from SDC
            bze     error               ; branch if error
        .ENDIF
            
            bra     newtable            ; start the process over again
            
            ;- extract starting cluster ----------------------------------------
startclust: ldy     #CLUSTEROFF         ; load cluster offset
            iny                         ; read MSB first
            lda     (pdirEntry), Y      ; read starting cluster number
            tax                         ; move MSB to X
            dey                         ; decrement offset to get LSB
            lda     (pdirEntry), Y      ; read first cluster number
            bra     exit                ; all done
            
            ;- error returns zero ----------------------------------------------
error:      lda     #0
            ldx     #0
            
            ;- exit ------------------------------------------------------------
exit:       rts                         ; done!

.ENDPROC


;= FAT16 READ ==================================================================
; Read a file from disk.
;
; Parameters:
;   X:A     = 16-bit destination address.
;   wCluster = starting cluster of file.
;
; Returns:
;   A = status.
;
; Remarks:
;   This function reads a file into RAM. It returns zero if unsuccessful or one
;   if successful.

.CODE

.PROC fat16_read

            sta     pabFile         ; save destination address
            stx     pabFile+1
            
            ;- compute sector for cluster --------------------------------------
loadfat:    lda     wCluster+1          ; load 16-bit cluster MSB
            sta     dwSector            ; store in dwSector argument
            lsr     dwSector            ; divide-by-2 (effective divide-by-512)
            
            ;- load appropriate portion of FAT for cluster ---------------------
            lda     dwFATRegion         ; load FAT region sector LBA
            add     dwSector            ; add computed sector for cluster
            sta     dwSector            ; store in dwSector argument
            lda     dwFATRegion+1
            adc     #0                  ; extend 8-bit value to 32-bits
            sta     dwSector+1
            lda     dwFATRegion+2
            adc     #0
            sta     dwSector+2
            lda     dwFATRegion+3
            adc     #0
            sta     dwSector+3
            lda     #.LOBYTE(FAT)       ; destination address for sector data
            ldx     #.HIBYTE(FAT)
        .IFNDEF SIM                     ; don't read SD card in simulator
            jsr     read                ; read root directory region from SDC
            bze     error               ; branch if error
        .ENDIF
            
            ;- compute offset into data region ---------------------------------
            lda     wCluster            ; load cluster number
            sub     #.LOBYTE(2)         ; sub. 2 to compute data region offset
            sta     dwSector            ; store data region offset
            lda     wCluster+1
            sbc     #.HIBYTE(2)
            sta     dwSector+1
            
            ;- compute RAM address of cluster ----------------------------------
            lda     wCluster            ; load cluster number
            and     #.LOBYTE(255)       ; adjust to 0-255 range
            asl     A                   ; multiply by 2 since 16-bit cluster no.
            sta     wCluster            ; store address offset
            lda     wCluster+1
            and     #.HIBYTE(255)
            rol     A
            sta     wCluster+1
            
            lda     wCluster            ; load FAT address offset
            add     #.LOBYTE(FAT)       ; add FAT address
            sta     wCluster            ; store cluster address
            lda     wCluster+1
            adc     #.HIBYTE(FAT)
            sta     wCluster+1
            
            ;- check for bad sector --------------------------------------------
            ldy     #1                  ; offset from cluster address
            lda     (wCluster), Y       ; load MSB of 16-bit cluster
            cmp     #.HIBYTE(BADSECTOR) ; compare with bad sector marker
            bne     ldcluster           ; branch if good sector
            lda     (wCluster)          ; load LSB of 16-bit cluster
            cmp     #.LOBYTE(BADSECTOR) ; compare with bad sector marker
            bne     ldcluster           ; branch if good sector
            
            ;- error -----------------------------------------------------------
error:      lda     #0                  ; file not loaded
            bra     exit
            
            ;- load cluster from SD card ---------------------------------------
ldcluster:  lda     dwDataRegion        ; load data region sector LBA
            add     dwSector            ; add offset for cluster sector
            sta     dwSector            ; store offset sector LBA
            lda     dwDataRegion+1
            adc     dwSector+1
            sta     dwSector+1
            lda     dwDataRegion+2
            adc     #0                  ; expand 16-bit value to 32-bits
            sta     dwSector+2
            lda     dwDataRegion+3
            adc     #0
            sta     dwSector+3
            lda     pabFile         ; destination address for sector data
            ldx     pabFile+1
        .IFNDEF SIM                     ; don't read SD card in simulator
            jsr     read                ; read data region from SDC
            bze     error               ; branch if error
        .ENDIF
            
            ;- check for end of cluster chain ----------------------------------
            ldy     #1                  ; offset for 16-bit cluster
            lda     (wCluster), Y       ; load cluster MSB
            cmp     #.HIBYTE($FFF0)     ; valid clusters are $0002-$FFEF 
            blt     lowerbound          ; branch if MSB less than $FF
            lda     (wCluster)          ; load cluster LSB
            cmp     #.LOBYTE($FFF0)     ; valid clusters are $0002-$FFEF
            bge     complete            ; branch if LSB >= $F0
            
lowerbound: lda     (wCluster), Y       ; load cluster MSB
            cmp     #.HIBYTE($0002)     ; valid clusters are $0002-$FFEF
            bnz     nextclust           ; branch if MSB not $00
            lda     (wCluster)          ; load cluster LSB
            cmp     #.LOBYTE($0002)     ; valid clusters are $0002-$FFEF
            blt     complete            ; branch if LSB less than $02
            
            ;- get next cluster number -----------------------------------------
nextclust:  lda     (wCluster)          ; load next cluster LSB
            tax                         ; store in X temporarily
            lda     (wCluster), Y       ; load next cluster MSB
            sta     wCluster+1          ; store new cluster MSB
            txa                         ; load new cluster LSB
            sta     wCluster            ; store new cluster LSB
            
            ;- increment destination address by 512 bytes ----------------------
            lda     pabFile         ; load destination address
            add     #.LOBYTE(512)       ; increment by 512
            sta     pabFile         ; store new destination address
            lda     pabFile+1
            adc     #.HIBYTE(512)
            sta     pabFile+1
            
            jmp     loadfat             ; keep loading the FAT
            
            ;- complete --------------------------------------------------------
complete:   lda     #1                  ; file load complete
exit:       rts                         ; done!

.ENDPROC


;===============================================================================
; UNINITIALIZED DATA
;===============================================================================

.BSS

pabFile:    .RES 2                      ; pointer to file data


;===============================================================================

.END
